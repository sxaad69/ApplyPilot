# ApplyPilot Environment Configuration
# Copy to ~/.applypilot/.env and fill in your values.

# LLM (OpenAI-compatible — OmniRoute, DeepSeek, Qwen, etc.)
# Stage 6 (Auto-Apply) is DISABLED; stages 1-5 route through this endpoint.
OPENAI_API_KEY=your_key
OPENAI_BASE_URL=http://localhost:20128/v1
LLM_MODEL=deepseek-chat

# Telegram (optional — leave blank to disable notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Job APIs (used during discovery)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
THE_MUSE_API_KEY=

# Search
SEARCH_KEYWORDS=python,backend,software engineer
SEARCH_LOCATION=remote
MIN_FIT_SCORE=7

# Optional: custom RSS/Atom job feeds (comma-separated)
# RSS_FEEDS=https://example.com/jobs.rss
